# Use your own credentials. Do not commit actual values.
DB_URL=jdbc:postgresql://localhost:5432/kala
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Used only if the seed loader needs to create a new admin account.
# An existing customer is never automatically promoted to admin.
KALA_ADMIN_EMAIL=studio@example.com
KALA_ADMIN_PASSWORD=replace_with_a_secure_admin_password
